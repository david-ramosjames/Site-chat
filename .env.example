# Database connection. On Railway, set DATABASE_URL to your Postgres instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/chattoconvert?schema=public"

# Public base URL used by the embeddable widget script tag.
# On Railway set this to your deployed domain, e.g. https://chatto-convert.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth — required for the admin login flow.
# NEXTAUTH_URL must match the deployed origin (Railway domain in prod,
# http://localhost:3000 locally). NEXTAUTH_SECRET is any 32+ byte
# random string; generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI:  ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Workspace email domain allowed to sign in. Defaults to ramosjames.com
# when unset. Set this to override (e.g. for a staging tenant).
AUTH_ALLOWED_EMAIL_DOMAIN="ramosjames.com"

# Optional outbound email provider for lead notifications.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="leads@example.com"

# Optional SMS provider for lead notifications.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE="+15125550100"

# Optional OpenAI-compatible endpoint when an admin selects "Custom API"
# for lead intelligence. OpenAI and Anthropic do not need this.
CUSTOM_LLM_BASE_URL=""
