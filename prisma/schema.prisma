// ChatToConvert - multi-tenant schema
// Each Client is a SaaS tenant. One row per business.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id            String   @id @default(cuid())
  name          String
  industry      String
  websiteUrl    String
  status        String   @default("active") // active | inactive
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  widgetSettings       WidgetSettings?
  featureToggles       FeatureToggles?
  notificationSettings NotificationSettings?
  flowSteps            FlowStep[]
  leads                Lead[]
  chatEvents           ChatEvent[]

  @@index([status])
}

// One row per visitor lifecycle milestone. Used to compute the chat
// conversion funnel: opened -> started -> completed_success / completed_decline.
// `sessionId` is a random per-page-load id from the widget so the same
// visitor's events can be deduped/joined client-side.
model ChatEvent {
  id        String   @id @default(cuid())
  clientId  String
  sessionId String
  type      String   // opened | started | completed_success | completed_decline
  source    String?  // for type=opened: "auto" (openOnLoad) or "click"
  sourceUrl String?
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([clientId, type])
  @@index([clientId, sessionId])
}

model WidgetSettings {
  id              String  @id @default(cuid())
  clientId        String  @unique
  primaryColor    String  @default("#2563eb")
  accentColor     String  @default("#1d4ed8")
  logoUrl         String?
  welcomeMessage  String  @default("Hi! How can we help?")
  bubbleText      String  @default("Chat with us")
  widgetPosition  String  @default("bottom-right")
  isActive        Boolean @default(true)

  // Optional intro video shown at the top of the chat panel when it opens.
  introVideoEnabled Boolean @default(false)
  introVideoUrl     String?
  introPosterUrl    String?
  introVideoStyle   String  @default("top") // top | background
  // Optional image that replaces the video after playback ends.
  introVideoEndImageUrl String?

  // Optional headshot/avatar on the floating bubble plus the speech-bubble tooltip.
  bubbleImageUrl String?
  bubbleTooltip  String?
  // Optional bubble/text colors for the tooltip speech bubble. Hex strings
  // (e.g. "#0b1220"). Null means use the built-in white-bg / dark-text default.
  bubbleTooltipBgColor   String?
  bubbleTooltipTextColor String?

  // Optional avatar shown next to each bot message inside the chat panel.
  // Usually a still photo of the same person; bubble avatar can be animated.
  chatAvatarUrl String?

  // Optional Spanish (or future multi-locale) copy. Shape:
  // { es: { welcomeMessage, bubbleText, bubbleTooltip, secondWelcomeMessage } }
  enableTranslation Boolean @default(false)
  translations      Json?

  // Optional second welcome message that replaces the bubble tooltip after
  // `secondWelcomeDelaySec` seconds of inactivity (re-engagement).
  secondWelcomeMessage  String?
  secondWelcomeDelaySec Int     @default(30)
  // Optional bubble/text colors for the re-engagement message. Same shape
  // as bubbleTooltipBgColor — null falls back to the tooltip default.
  secondWelcomeBgColor   String?
  secondWelcomeTextColor String?

  // Optional column of action buttons (Phone, SMS, Messenger, WhatsApp, custom)
  // shown opposite the chat bubble. Each entry has its own device + locale gates.
  // Shape: [{ type, label, destination, showOnDesktop, showOnMobile,
  //           showInEnglish, showInSpanish }]
  sideButtons         Json?
  sideButtonsPosition String  @default("bottom") // bottom | center

  // Optional end-of-flow CTAs shown after a lead submits. Shape:
  // [{ type: 'call'|'text'|'schedule'|'link', label, destination }]
  endCtas Json?

  // If true the chat panel auto-opens on page load (instead of starting as
  // the floating avatar/bubble). Useful when the intro video should be
  // visible immediately.
  openOnLoad Boolean @default(false)

  // Optional decline ("we can't help you") end state. When a branch routes
  // to "__decline", the lead still submits but the visitor sees this
  // headline + message instead of the success view + CTAs.
  declineHeadline String?
  declineMessage  String?

  // Optional editable success copy shown above the end CTAs after a
  // lead submits. When blank, falls back to the built-in EN/ES defaults.
  successHeadline String?
  successMessage  String?

  // Optional Google Ads conversion tracking. When both are set the
  // widget fires gtag('event','conversion', { send_to: id/label }) on
  // the host page after a successful lead submit. dataLayer push happens
  // either way so GTM-based setups can pick the event up too.
  googleAdsConversionId    String?
  googleAdsConversionLabel String?

  // Optional CallRail Dynamic Number Insertion override. When on, the
  // widget reads the swapped phone from the host page (CallRail's swap.js
  // must already be loaded there) and uses that for Call/Text/SMS/WhatsApp
  // destinations instead of the admin-configured number.
  callRailUseDynamicNumber     Boolean @default(false)
  callRailSwapWaitMs           Int     @default(800)
  callRailDynamicNumberSelector String?

  // Branding footer ("Powered by RJL-Chat") shown at the bottom of the chat
  // panel. Disable to remove it, or set a custom string to override the copy.
  brandingFooterEnabled Boolean @default(true)
  brandingFooterText    String?

  // Default country for normalising visitor-entered phone numbers to E.164
  // before forwarding to CallRail. "US" prepends +1 to 10-digit numbers,
  // "MX" prepends +52. Visitor input that already starts with + is
  // preserved as-is so international entries always win.
  defaultPhoneCountry String @default("US")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model FeatureToggles {
  id                    String  @id @default(cuid())
  clientId              String  @unique
  showProgress          Boolean @default(true)
  allowFileUpload       Boolean @default(false)
  collectUtm            Boolean @default(true)
  collectPageUrl        Boolean @default(true)
  collectReferrer       Boolean @default(true)
  enableAiSummary       Boolean @default(false)
  enableLeadScoring     Boolean @default(false)
  enableAfterHours      Boolean @default(false)
  enableSmsAlerts       Boolean @default(false)
  enableEmailAlerts     Boolean @default(true)
  enableSlackAlerts     Boolean @default(false)
  enableGoogleSheetSync Boolean @default(false)
  enableCrmWebhook      Boolean @default(false)
  enableMedia           Boolean @default(true)
  enableFallbackForm    Boolean @default(true)
  enableSpamProtection  Boolean @default(true)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model NotificationSettings {
  id                   String  @id @default(cuid())
  clientId             String  @unique
  email                String?
  phone                String?
  slackWebhookUrl      String?
  crmWebhookUrl        String?
  googleSheetWebhookUrl String?

  // CallRail Form Capture API credentials. When account ID + API key are
  // both set, completed leads are forwarded into CallRail as form
  // submissions (in addition to the lead row, Slack alerts, etc.).
  // accountId is the alphanumeric ACC… ID (top-level container).
  // companyId is the numeric ID after /companies/ in the swap.js URL —
  // required in the form submission body.
  callRailAccountId String?
  callRailCompanyId String?
  callRailApiKey    String?
  callRailFormId    String?

  // Optional Slack header overrides — one per "priority state" combination.
  // Use {{businessName}} as a placeholder; defaults fall back to the
  // built-in 🔥/🎁/🟢 phrasing when a field is blank.
  slackHeaderPriorityReferral String?
  slackHeaderPriority         String?
  slackHeaderReferral         String?
  slackHeaderDefault          String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model FlowStep {
  id               String  @id @default(cuid())
  clientId         String
  stepKey          String
  order            Int
  question         String
  inputType        String  // text | phone | email | multiple_choice | yes_no | textarea | date | zip
  isRequired       Boolean @default(true)
  options          Json?   // [{ value, label }] or yes/no labels
  nextLogic        Json?   // optional branching
  mediaType        String  @default("none") // none | image | video
  mediaUrl         String?
  thumbnailUrl     String?
  altText          String?
  mediaDisplayStyle String @default("above") // above | below | background

  // Optional lead-column mapping. If set, the answer to this step
  // populates that field on the Lead row (name | phone | email |
  // service | qualified | referral). Falls back to stepKey-name
  // conventions when null.
  leadField       String?
  // For yes_no steps mapped to qualified/referral: per-answer override
  // of what gets written to the column. Null = use the raw answer.
  // E.g. for "Do you have an attorney?" set leadFieldOnYes="no" and
  // leadFieldOnNo="yes" — answering No means qualified=yes.
  leadFieldOnYes  String?
  leadFieldOnNo   String?

  // Optional translated copy. Shape: { es: { question, options: [{value,label}] } }
  translations Json?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, stepKey])
  @@index([clientId, order])
}

model Lead {
  id               String   @id @default(cuid())
  clientId         String
  name             String?
  phone            String?
  email            String?
  serviceRequested String?
  qualified        String?
  referral         String?
  status           String   @default("new") // new | contacted | booked | lost | spam
  sourceUrl        String?
  referrer         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  gclid            String?
  msclkid          String?
  fbclid           String?
  ttclid           String?
  wbraid           String?
  gbraid           String?
  ndclid           String?
  landingPageUrl   String?
  callrailSessionId         String?
  callrailFormSubmissionId  String?
  userAgent        String?
  transcript       Json?    // [{ role, text, stepKey }]
  answers          Json?    // { stepKey: value }
  aiSummary        String?
  leadScore        Int?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([clientId, status])
}
